# Test Environment Variables
NODE_ENV=test
API_PORT=3001
PORT=3001
JWT_SECRET=test_jwt_secret_key_123456789

# Kakao OAuth Configuration (Test)
KAKAO_CLIENT_ID=test_client_id
KAKAO_CLIENT_SECRET=test_client_secret
KAKAO_REDIRECT_URI=http://localhost:3001/api/auth/kakao/callback

# Database Configuration (Test)
# - 로컬 개발: RPi 테스트 DB의 Tailscale IP로 교체 (RPi에서 `tailscale ip -4` 확인, 예: 100.x.y.z)
# - CI: postgres service container가 env로 DB_HOST=localhost 등을 주입 (이 파일이 덮어쓰지 않음)
# - 주의: amazonaws.com 호스트(RDS)는 테스트에서 금지 — tests/setup/globalSetup.js가 차단함
DB_HOST=localhost
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=honbabnono_test
DB_PORT=5432
DB_SSL=false

# AWS S3 Configuration (Test - Mock)
AWS_ACCESS_KEY_ID=test_access_key_id
AWS_SECRET_ACCESS_KEY=test_secret_access_key
AWS_REGION=ap-northeast-2
S3_BUCKET=test-honbabnono-bucket

# Test Flags
# 외부 API(PortOne, NTS 등)는 jest.mock으로 차단함 — 코드에서 읽는 플래그 아님
SKIP_DB_CONNECTION=false
LOG_LEVEL=error
ENABLE_LOGGING=false

# Performance Settings
MAX_CONNECTIONS=5
QUERY_TIMEOUT=5000
REQUEST_TIMEOUT=10000

# Security Settings for Tests
BCRYPT_ROUNDS=1
SESSION_SECRET=test_session_secret

# Feature Flags for Testing
ENABLE_RATE_LIMITING=false
ENABLE_CORS=true
TRUST_PROXY=false
